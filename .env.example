# Copy to .env.local for local work. Never commit .env.local or real values.
# Production values are set on the server (/home/dklao/.config/dklao-site.env, see docs/deploy-checklist.md), not in files.

# --- Public site -------------------------------------------------------------
# Canonical site address. Used for metadata and the sitemap.
APP_URL=http://localhost:3000

# --- CMS database (PostgreSQL) -----------------------------------------------
# Leave DATABASE_URL empty to run the site from its built-in content with no CMS.
# Local:      postgresql://USER:PASSWORD@127.0.0.1:5433/dklao_cms
# Supabase:   use the pooled connection string from the project's Connect panel for the running site,
#             and the direct or session connection string when running migrations.
DATABASE_URL=

# Connections each server instance may open. Use 10 locally; see docs/deploy-checklist.md for the server.
DATABASE_POOL_MAX=10

# --- CMS secret ----------------------------------------------------------------
# Signs admin login sessions. At least 32 random characters, different per environment. A production server
# with DATABASE_URL set refuses to start without one (src/instrumentation.ts).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Quote form: spam protection and new-lead notification ------------------
# Requests allowed per visitor address, per window. Defaults: 5 per 600 seconds.
LEAD_RATE_LIMIT=5
LEAD_RATE_WINDOW_SECONDS=600
# Requests that arrive without a usable visitor address (X-Real-IP missing, for example after a proxy
# change) share one bucket with this larger budget per window, so one visitor cannot close the form for
# everyone. Default: 60. The server logs a warning once when this happens in production.
LEAD_SHARED_RATE_LIMIT=60

# Notification: one outbound webhook. Point it at Make, n8n, Zapier, a WhatsApp Business gateway,
# Slack or an email relay. Leave empty for no notification. https only (http allowed for localhost).
LEAD_NOTIFY_WEBHOOK_URL=
# Optional. When set, each call carries X-DKLAO-Signature: sha256=<hmac of the body> so the receiver can verify it.
LEAD_NOTIFY_WEBHOOK_SECRET=
# summary (default): lead id, category, company and an admin link only.
# full: also the contact name, phone, email and message. Choose full only for a receiver you trust.
LEAD_NOTIFY_DETAILS=summary

# Email: every request is also emailed, in full, to DK LAO's own inbox over SMTP. Leave SMTP_HOST empty
# for no email (developer machines). Port 465 = TLS, 587 or 25 = STARTTLS. Set SMTP_USER and SMTP_PASS
# together, in the hosting provider's environment settings only, never in a committed file.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown in the inbox. Defaults to SMTP_USER.
SMTP_FROM=
# Where requests go. Defaults to info@dklao.com. Several addresses: comma-separated.
LEAD_NOTIFY_EMAIL=info@dklao.com

# --- Not read by the app --------------------------------------------------------
# SUPABASE_ACCESS_TOKEN and VERCEL_TOKEN are deployment tokens. They never go in this file or in Vercel
# environment variables for the site. Keep them in the password manager, or as GitHub Actions secrets
# if a deploy workflow is added later.
