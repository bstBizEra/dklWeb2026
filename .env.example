# Copy to .env.local for local work. Never commit .env.local or real values.
# Production values are set in the Vercel project settings, not in files.

# --- Public site -------------------------------------------------------------
# Canonical site address. Used for metadata and the sitemap.
APP_URL=http://localhost:3000

# --- CMS database (PostgreSQL) -----------------------------------------------
# Leave DATABASE_URL empty to run the site from its built-in content with no CMS.
# Local:      postgresql://USER:PASSWORD@127.0.0.1:5433/dklao_cms
# Supabase:   use the pooled connection string from the project's Connect panel for the running site,
#             and the direct or session connection string when running migrations.
DATABASE_URL=

# Connections each server instance may open. Use 1 to 3 on Vercel, 10 locally.
DATABASE_POOL_MAX=10

# --- CMS secret ----------------------------------------------------------------
# Signs admin login sessions. At least 32 random characters, different per environment.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Not read by the app --------------------------------------------------------
# SUPABASE_ACCESS_TOKEN and VERCEL_TOKEN are deployment tokens. They never go in this file or in Vercel
# environment variables for the site. Keep them in the password manager, or as GitHub Actions secrets
# if a deploy workflow is added later.
