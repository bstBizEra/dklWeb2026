#!/usr/bin/env bash
# DK LAO preview deploy, run on the server as the dklao user. Install once (docs/deploy-checklist.md 3a):
#   ~/bin/dklao-deploy-preview, mode 700, and in ~/.ssh/authorized_keys:
#   restrict,command="/home/dklao/bin/dklao-deploy-preview" ssh-ed25519 AAAA... github-actions-dklao-preview
#
# The GitHub Actions deploy key can run nothing else. The workflow sends
#   ssh dklao@host "deploy preview-<run>-<sha>" < bundle
# and this script saves the bundle, checks out its tag, installs and builds, restarts dklao-site and
# checks it answers. If the build or the check fails, it rebuilds and restarts the previous version.
set -euo pipefail
umask 077

export PATH="/opt/cpanel/ea-nodejs22/bin:/usr/local/bin:$HOME/.local/share/pnpm:$HOME/bin:/usr/bin:/bin"
export NEXT_TELEMETRY_DISABLED=1

APP="$HOME/dklao-app"
BUNDLES="$HOME/deploy-bundles"
LOGS="$HOME/deploy-logs"
KEEP_BUNDLES=5
MAX_BUNDLE_BYTES=209715200 # 200 MB

read -r action tag extra <<<"${SSH_ORIGINAL_COMMAND:-}" || true
if [[ "${action:-}" != "deploy" || -n "${extra:-}" || ! "${tag:-}" =~ ^preview-[0-9]+-[0-9a-f]{7,40}$ ]]; then
  echo "usage: deploy preview-<run>-<sha>" >&2
  exit 2
fi

command -v pnpm >/dev/null || { echo "pnpm not found on PATH ($PATH)" >&2; exit 3; }
mkdir -p "$BUNDLES" "$LOGS"

bundle="$BUNDLES/$tag.bundle"
head -c "$MAX_BUNDLE_BYTES" > "$bundle"
cd "$APP"
git bundle verify --quiet "$bundle"

previous="$(git describe --tags --always)"
echo "previous=$previous" > "$LOGS/$tag.previous"
git fetch --quiet "$bundle" "refs/tags/$tag:refs/tags/$tag"

# Each step is chained: inside an if condition bash ignores set -e.
build() {
  git checkout --quiet --force "$1" && pnpm install --frozen-lockfile && pnpm build
}

healthy() {
  # The site must answer 200 with the build just made: every page carries Next's random build ID (escaped,
  # as \"b\":\"<id>\"), so an old process that has not restarted yet never passes.
  local code="" page id
  id="$(cat "$APP/.next/BUILD_ID")"
  for _ in $(seq 1 30); do
    sleep 2
    page="$(curl -s -w '\n%{http_code}' http://127.0.0.1:3110/ || true)"
    code="${page##*$'\n'}"
    [[ "$code" == "200" && "$page" == *"$id"* ]] && return 0
  done
  echo "health check: last answer $code, build $id not served" >&2
  return 1
}

backup_database() {
  # Migrations run when the service starts and cannot be undone by a code rollback, so any release that
  # changes src/payload/migrations gets a database dump first. No dump, no restart.
  if git diff --quiet "$previous" "$tag" -- src/payload/migrations; then
    return 0
  fi
  local url dump
  url="$(grep -m1 '^DATABASE_URL=' "$HOME/.config/dklao-site.env" | cut -d= -f2- | sed -e 's/^"//' -e 's/"$//')"
  [[ -n "$url" ]] || { echo "DATABASE_URL not found in ~/.config/dklao-site.env" >&2; return 1; }
  dump="$HOME/backups/dklao_dklApp-before-$tag.sql"
  mkdir -p "$HOME/backups" && pg_dump --dbname="$url" > "$dump" || { echo "database dump failed" >&2; return 1; }
  echo "migrations changed: database saved to $dump"
}

restart() {
  # dklao's SSH shell is cPanel's jailshell (nosuid), where sudo cannot work. Writing this file starts the
  # root path unit dklao-site-restart.path, which restarts dklao-site and nothing else (checklist 3a).
  printf '%s %s\n' "$tag" "$(date -u +%FT%TZ)" > "$HOME/.deploy/restart-request" ||
    { echo "restart request failed: check ~/.deploy and dklao-site-restart.path (docs/deploy-checklist.md 3a)" >&2; return 1; }
}

echo "deploy $tag (running: $previous)"
if ! build "$tag" > "$LOGS/build-$tag.log" 2>&1; then
  echo "build of $tag failed; rolling back to $previous. Last lines of $LOGS/build-$tag.log:" >&2
  tail -n 40 "$LOGS/build-$tag.log" >&2
elif backup_database && restart && healthy; then
  echo "deployed $tag"
  # Keep the newest bundles only.
  ls -1t "$BUNDLES"/*.bundle 2>/dev/null | tail -n +"$((KEEP_BUNDLES + 1))" | xargs -r rm -f --
  exit 0
else
  echo "$tag was built but not brought up; rolling back to $previous" >&2
fi

if build "$previous" > "$LOGS/rollback-$tag.log" 2>&1 && restart && healthy; then
  echo "rolled back to $previous" >&2
else
  echo "ROLLBACK FAILED: see $LOGS/rollback-$tag.log; the site needs attention" >&2
fi
exit 1
